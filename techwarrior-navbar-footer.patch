+import { Component, computed, input, output } from '@angular/core';
+import { User } from '../../services/auth.service';
+import { USER_ROLE_LABELS } from '../../entities';
+
+// Parte della navbar che mostra l'utente loggato e il pulsante di uscita
+@Component({
+    selector: 'app-nav-user',
+    templateUrl: './nav-user.component.html',
+    // styleUrl: './nav-user.component.css',  // lo aggiungi quando farai il css
+})
+export class NavUserComponent {
+    user = input.required<User>();
+
+    logoutEvent = output({ alias: 'logout' });
+
+    // "Cittadino" / "Ente comunale"
+    ruolo = computed(() => USER_ROLE_LABELS[this.user().role]);
+
+    logout() {
+        this.logoutEvent.emit();
+    }
+}
diff --git a/src/app/components/navbar/navbar.component.html b/src/app/components/navbar/navbar.component.html
index e69de29..290ad8a 100644
--- a/src/app/components/navbar/navbar.component.html
+++ b/src/app/components/navbar/navbar.component.html
@@ -0,0 +1,23 @@
+<nav aria-label="Navigazione principale">
+    <!-- da loggato il logo porta al feed, altrimenti al login -->
+    <a [routerLink]="currentUser() ? '/feed' : '/login'">TechWarrior</a>
+    <span>{{ citta }}</span>
+
+    <!-- link alle pagine: solo da loggato -->
+    <ul *ifAuthenticated>
+        <li><a routerLink="/feed" routerLinkActive="active">Feed</a></li>
+        <li><a routerLink="/mappa" routerLinkActive="active">Mappa</a></li>
+        <li><a routerLink="/inviti" routerLinkActive="active">Inviti volontari</a></li>
+        <!-- solo il cittadino può inviare segnalazioni (al back un ente riceverebbe 403) -->
+        <li *ifRole="'cittadino'"><a routerLink="/segnalazione" routerLinkActive="active">Nuova segnalazione</a></li>
+    </ul>
+
+    <app-nav-user *ifAuthenticated="true; else notLogged" [user]="currentUser()!" (logout)="logout()" />
+
+    <ng-template #notLogged>
+        @if (showAuthBtns()) {
+        <a routerLink="/login">Accedi</a>
+        <a routerLink="/register">Registrati</a>
+        }
+    </ng-template>
+</nav>
diff --git a/src/app/components/navbar/navbar.component.ts b/src/app/components/navbar/navbar.component.ts
index e69de29..559f3e6 100644
--- a/src/app/components/navbar/navbar.component.ts
+++ b/src/app/components/navbar/navbar.component.ts
@@ -0,0 +1,49 @@
+import { Component, computed, inject } from '@angular/core';
+import { toSignal } from '@angular/core/rxjs-interop';
+import { filter, map } from 'rxjs';
+import { NavigationEnd, Router, RouterLink, RouterLinkActive } from '@angular/router';
+import { AuthService } from '../../services/auth.service';
+import { NavUserComponent } from '../nav-user/nav-user.component';
+import { IfAuthenticatedDirective } from '../../utils/if-authenticated.directive';
+import { IfRoleDirective } from '../../utils/if-role.directive';
+
+@Component({
+    selector: 'app-navbar',
+    imports: [
+        RouterLink,
+        RouterLinkActive,
+        NavUserComponent,
+        IfAuthenticatedDirective,
+        IfRoleDirective,
+    ],
+    templateUrl: './navbar.component.html',
+    // styleUrl: './navbar.component.css',  // lo aggiungi quando farai il css
+})
+export class NavbarComponent {
+    private authSrv = inject(AuthService);
+    private router = inject(Router);
+
+    currentUser = this.authSrv.currentUser;
+
+    // Dal mockup del feed la città compare nell'header. Per ora è fissa
+    protected readonly citta = 'Vicenza';
+
+    // url corrente senza query string (es. /login?dest=/feed -> /login)
+    private currentPath = toSignal(
+        this.router.events.pipe(
+            filter(event => event instanceof NavigationEnd),
+            map(event => event.urlAfterRedirects.split('?')[0])
+        ),
+        { initialValue: this.router.url.split('?')[0] }
+    );
+
+    // nelle pagine di login e registrazione i pulsanti Accedi/Registrati in navbar sono superflui
+    showAuthBtns = computed(() => !['/login', '/register'].includes(this.currentPath()));
+
+    logout() {
+        this.authSrv.logout();
+        // vado direttamente al login: restare sulla pagina corrente non rieseguirebbe la guard
+        // (Angular riusa la rotta) e la pagina resterebbe visibile
+        this.router.navigate(['/login']);
+    }
+}
